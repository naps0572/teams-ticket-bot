# ─────────────────────────────────────────────────────────────
#  OpenRouter (obligatorio para que el bot razone)
# ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
# Cualquier modelo disponible en OpenRouter. Ejemplos:
#   anthropic/claude-3.5-sonnet
#   openai/gpt-4o-mini
#   google/gemini-2.0-flash-001
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Reintentos ante 429/5xx (útil con modelos ":free" que se saturan). Por defecto 3.
# OPENROUTER_MAX_RETRIES=3
# Opcionales (atribución en los rankings de OpenRouter):
# OPENROUTER_SITE_URL=https://tu-empresa.com
# OPENROUTER_APP_NAME=Bot de Tickets

# ─────────────────────────────────────────────────────────────
#  ITSM — Ivanti Service Manager (OData REST)
#  Si dejas ITSM_BASE_URL vacío, el bot corre en modo dry-run
#  (tickets simulados LOCAL-xxxx para poder probar sin Ivanti).
# ─────────────────────────────────────────────────────────────
# ITSM_BASE_URL=https://gruposiman-amc.ivanticloud.com
# ITSM_API_KEY=xxxxxxxxxxxxxxxxxxxx            # rest_api_key de Ivanti
# ITSM_OBJECT_TYPE=incidents                   # "incidents" o "servicereqs"
# Campos obligatorios al crear incidente (listas validadas de Ivanti):
# ITSM_DEFAULT_CATEGORY=General
# ITSM_DEFAULT_SERVICE=General
# ITSM_DEFAULT_TEAM=Mesa de Servicio
# ITSM_DEFAULT_PROFILE_LINK=<RecId de empleado usado como Customer fallback>
# ITSM_SR_TEMPLATE_RECID=<RecId de plantilla SR por defecto (SvcReqTmplLink)>

# ─────────────────────────────────────────────────────────────
#  Teams / Azure Bot (solo para correr DENTRO de Teams, no en DevTools)
#  Se obtienen al registrar el recurso Azure Bot (ver README).
# ─────────────────────────────────────────────────────────────
# CLIENT_ID=00000000-0000-0000-0000-000000000000
# CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx
# TENANT_ID=00000000-0000-0000-0000-000000000000

# Entorno
NODE_ENV=development
PORT=3978
